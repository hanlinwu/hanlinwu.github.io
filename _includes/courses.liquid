{% if site.teachings %}
  <div class="courses">
    {% assign courses = site.teachings | sort: 'term_order' | reverse %}
    {% assign current_term = '' %}

    {% for course in courses %}
      {% if course.term != current_term %}
        {% unless forloop.first %}
          </div>
        {% endunless %}
        {% assign current_term = course.term %}
        {% assign term_heading = course.term | replace: ' 春季学期', ' 春' | replace: ' 秋季学期', ' 秋' %}
      <h2 class="year">{{ term_heading }}</h2>
      <div class="course-list">
      {% endif %}
          <div class="course-item">
            <h3 class="course-title">
              <a href="{{ course.url | relative_url }}">{{ course.title }}</a>
            </h3>

            <div class="course-meta">
              {% if course.term %}
                <span class="course-term">{{ course.term }}</span>
              {% endif %}

              {% if course.instructor %}
                <span class="course-instructor">{{ course.instructor }}</span>
              {% endif %}

              {% if course.weeks %}
                <span class="course-weeks">{{ course.weeks }}</span>
              {% endif %}

              {% if course.location %}
                <span class="course-location">{{ course.location }}</span>
              {% endif %}

              {% if course.time %}
                <span class="course-time">{{ course.time }}</span>
              {% endif %}
            </div>

            {% if course.description %}
              <div class="course-description">
                {{ course.description | markdownify }}
              </div>
            {% endif %}
          </div>
      {% if forloop.last %}
      </div>
      {% endif %}
    {% endfor %}
  </div>
{% else %}
  <p>No courses available yet.</p>
{% endif %}
