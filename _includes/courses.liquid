{% if site.teachings %}
  <div class="courses">
    {% assign courses = site.teachings | sort: 'term_order' | reverse %}
    {% assign current_term = '' %}

    {% for course in courses %}
      {% if course.term != current_term %}
        {% unless forloop.first %}
          </div>
        {% endunless %}
        {% assign current_term = course.term %}
        {% assign semester = course.term | split: ' ' | last %}
      <h2 class="course-term-heading">
        {% if course.academic_year %}
          <span>{{ course.academic_year }} 学年</span>
          <span class="course-semester">{{ semester }}</span>
        {% else %}
          <span>{{ course.term }}</span>
        {% endif %}
      </h2>
      <div class="course-list">
      {% endif %}
          <article class="course-item">
            {% if course.course_level %}
              <div class="course-level">{{ course.course_level }}</div>
            {% endif %}
            <h3 class="course-title">
              <a href="{{ course.url | relative_url }}">{{ course.title }}</a>
            </h3>

            <dl class="course-meta">
              <div class="course-meta-row">
                <dt>上课时间</dt>
                <dd>
                  {% if course.time %}
                    {{ course.time }}
                    {% if course.weeks %}<span class="course-weeks">{{ course.weeks }}</span>{% endif %}
                  {% else %}
                    <span class="course-pending">待公布</span>
                  {% endif %}
                </dd>
              </div>
              <div class="course-meta-row">
                <dt>上课地点</dt>
                <dd>
                  {% if course.location %}{{ course.location }}{% else %}<span class="course-pending">待公布</span>{% endif %}
                </dd>
              </div>
            </dl>
          </article>
      {% if forloop.last %}
      </div>
      {% endif %}
    {% endfor %}
  </div>
{% else %}
  <p>No courses available yet.</p>
{% endif %}
